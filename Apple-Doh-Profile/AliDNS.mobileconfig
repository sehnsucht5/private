<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDisplayName</key>
	<string>AliDNS</string>
	<key>PayloadDescription</key>
	<string>Configures encrypted DNS (DNS over HTTPS) for secure DNS resolution.</string>
	<key>PayloadIdentifier</key>
	<string>dns.alidns.com</string>
	<key>PayloadOrganization</key>
	<string>Notion</string>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>HTTPS</string>
				<key>ServerURL</key>
				<string>https://dns.alidns.com/dns-query</string>
				<key>ServerAddresses</key>
				<array>
					<string>223.5.5.5</string>
					<string>223.6.6.6</string>
					<string>2400:3200::1</string>
					<string>2400:3200:baba::1</string>
				</array>
			</dict>
			<key>OnDemandRules</key>
			<array>
				<dict>
					<key>Action</key>
					<string>EvaluateConnection</string>
					<key>ActionParameters</key>
					<array>
						<dict>
							<key>DomainAction</key>
							<string>NeverConnect</string>
							<key>Domains</key>
							<array>
								<!-- Apple Captive Portal -->
								<string>captive.apple.com</string>
								<string>www.apple.com</string>
								<!-- 常見電信商語音信箱 -->
								<string>dav.orange.fr</string>
								<string>vvm.mobistar.be</string>
								<string>vvm.mstore.msg.t-mobile.com</string>
								<string>tma.vvm.mone.pan-net.eu</string>
								<string>vvm.ee.co.uk</string>
								<string>vvm.vodafone.com</string>
								<string>msg.t-mobile.com</string>
								<!-- 其他常見連線檢測 -->
								<string>connectivitycheck.gstatic.com</string>
								<string>clients3.google.com</string>
								<string>detectportal.firefox.com</string>
								<string>nmcheck.gnome.org</string>
								<!-- iCloud Private Relay -->
								<string>mask.icloud.com</string>
								<string>mask-h2.icloud.com</string>
							</array>
						</dict>
					</array>
				</dict>
				<dict>
					<key>Action</key>
					<string>Connect</string>
				</dict>
			</array>
			<key>PayloadDisplayName</key>
			<string>AliDNS</string>
			<key>PayloadIdentifier</key>
			<string>dns.alidns.com.dns</string>
			<key>PayloadOrganization</key>
			<string>Notion</string>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadUUID</key>
			<string>B63B4539-D360-4F62-8E7F-53CF36C8E3FC</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>ProhibitDisablement</key>
			<false/>
		</dict>
	</array>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>A2ED0CDE-3989-45C5-95E8-D1567B85C037</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>